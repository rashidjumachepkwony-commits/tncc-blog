# Copy to .env for LOCAL testing only. Never commit .env to git.
# Real secrets live in Supabase Dashboard > Project Settings > Edge Functions > Secrets
# or via: supabase secrets set RESEND_API_KEY=... (see supabase/functions/send-notification/README.md)

# Resend (server-side only - NEVER put in supabase-config.js or any frontend file)
RESEND_API_KEY=your-resend-api-key-here

# Notification function config (server-side)
TNCC_ADMIN_EMAIL=tesonorthcrosscountrycbo@gmail.com
TNCC_SENDER_EMAIL=TNCC website <onboarding@resend.dev>
# After verifying a domain in Resend, use e.g.:
# TNCC_SENDER_EMAIL=TNCC website <no-reply@your-verified-domain.com>

# Supabase Edge Function system vars (auto-provided in cloud, needed only for local serve)
# SUPABASE_URL=https://eadrlxpgxcgdhftkqwqa.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (never commit, never expose to browser)